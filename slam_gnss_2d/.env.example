# Display
DISPLAY=:0

# Host data directory to mount (defaults to ${HOME}/ros2_data if unset)
# HOST_DATA_DIR=${HOME}/ros2_data

# Paths inside container (/root/ros2_data or /data)
DATA_DIR=/root/ros2_data
ROSBAG_PATH=${DATA_DIR}/rosbag
ROSBAG_FILE=${ROSBAG_PATH}/sample_bag
INPUT_DIR=${DATA_DIR}/map/latest
SAVE_DIR=${DATA_DIR}/map/latest_opt
