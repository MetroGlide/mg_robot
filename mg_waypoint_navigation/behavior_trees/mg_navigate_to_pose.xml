<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 詰まっても諦めずに待ち続ける (詰まりはシーケンサが /diagnostics に出す) -->
    <RecoveryNode number_of_retries="99999" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithReplanning">
        <!-- 走行開始・やり直し・ゴール上書き (通過点の preemption) の直後に計画する。
             計画が失敗しても、同じゴールへの経路があればそれで追従を続ける。
             別のゴールへの経路しかなければ CommitPath が経路を捨てて失敗し、リカバリーに入る -->
        <GoalUpdatedController>
          <Sequence name="ComputePathOnGoalUpdate">
            <ForceSuccess>
              <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            </ForceSuccess>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
          </Sequence>
        </GoalUpdatedController>
        <!-- 定期的な再計画。失敗しても直前の経路を保ち、障害物の判定は RPP に任せる。
             経路の近くが塞がっている間は再計画しない (急に現れた障害物は、迂回せずにまず
             failure_tolerance の間待ち、居座ればリカバリーで迂回する)。
             Inverter と IsPathBlocked の行を外すと、迂回路があれば待たずにすぐ乗る動きになる
             (リカバリーはそのまま使える) -->
        <RateController hz="1.0">
          <ForceSuccess>
            <Sequence name="ReplanPath">
              <Inverter>
                <IsPathBlocked path="{path}"/>
              </Inverter>
              <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
              <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            </Sequence>
          </ForceSuccess>
        </RateController>
        <!-- 前方に障害物があると RPP が止まり、failure_tolerance の間待ってから失敗する -->
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>

      <!-- 段階を上から順に試し、引き直した経路が RPP と同じ判定 (経路の向きへの旋回を含む) で
           塞がっていなければ、その時点で走行へ戻る。段階の中の失敗 (計画の失敗、塞がった経路、
           後退・首振りの衝突による中止) は次の段階へ進む。段階の間に RPP の待ちは挟まない。
           どの段階の途中でも、IsPathClear が「空いた」と判定したら中断して走行へ戻る。
           中断・終了のたびに、次のリカバリーは最初の段階から始まる -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <IsPathClear path="{path}"/>
        <Fallback name="RecoveryLadder">

          <!-- 計画用地図の障害物 (進入禁止の領域) にめり込んでいると、プランナが「始点が致死」で計画できない。
               自己位置が信頼できる (監督の状態が NORMAL) ときだけ、その領域の外の最も近い位置を始点にして計画し、
               領域から出る (走行はセンサだけのローカルコストマップが見る)。自己位置が疑わしいときは復旧に任せる。
               めり込んでいなければ FindFreeStart が失敗して、次の段階へ進む。この段階を外すと脱出しない -->
          <Sequence name="EscapeKeepout">
            <IsLocalizationHealthy/>
            <FindFreeStart free_start="{free_start}"/>
            <ComputePathToPose goal="{goal}" start="{free_start}" path="{candidate_path}" planner_id="GridBased"/>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            <Inverter>
              <IsPathBlocked path="{path}"/>
            </Inverter>
          </Sequence>

          <!-- 今のコストマップで引き直す -->
          <Sequence name="Replan">
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            <Inverter>
              <IsPathBlocked path="{path}"/>
            </Inverter>
          </Sequence>

          <!-- 残った障害物の痕跡を消して引き直す。クリア直後の空の地図で通れると判定しないよう、
               グローバル・ローカルのコストマップが作り直されて届くまで (両方の更新周期より長く) 待つ -->
          <Sequence name="ClearAndReplan">
            <ClearEntireCostmap name="ClearLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap" service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="2"/>
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            <Inverter>
              <IsPathBlocked path="{path}"/>
            </Inverter>
          </Sequence>

          <!-- 近くの実在の障害物で今の経路が塞がっているときだけ、ゆっくり短く下がって距離を取る。
               計画が他の理由 (自己位置のずれ、地図との不一致) で失敗しているときは下がらない
               (ローカルコストマップはセンサだけで作る)。後退は collision_monitor を経由しないので、
               behavior_server がローカルコストマップで後方の衝突を確かめる -->
          <Sequence name="BackUpAndReplan">
            <IsPathBlocked path="{path}"/>
            <BackUp backup_dist="0.3" backup_speed="0.1"/>
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            <Inverter>
              <IsPathBlocked path="{path}"/>
            </Inverter>
          </Sequence>

          <!-- 向きを変えて引き直す (回る速さは behavior_server の max_rotational_vel) -->
          <Sequence name="SpinLeftAndReplan">
            <Spin spin_dist="0.5"/>
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            <Inverter>
              <IsPathBlocked path="{path}"/>
            </Inverter>
          </Sequence>

          <!-- 逆向きに振る (向きの変化は合計 -0.5rad) -->
          <Sequence name="SpinRightAndReplan">
            <Spin spin_dist="-1.0"/>
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            <CommitPath candidate="{candidate_path}" goal="{goal}" path="{path}"/>
            <Inverter>
              <IsPathBlocked path="{path}"/>
            </Inverter>
          </Sequence>

          <!-- どの段階でも通れなければ待ってから走行へ戻り、RPP の待ちからくり返す -->
          <Wait wait_duration="3"/>

        </Fallback>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>
