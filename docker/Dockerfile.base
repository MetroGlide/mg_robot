# syntax=docker/dockerfile:1
ARG ROS_DISTRO=humble

# ==============================================================================
# Stage: runtime-base
# apt / pip / pre-copy / vcs_import(||true) / rosdep(||true) をキャッシュ層として分離
# ソースコード変更でこの層が無効化されないようにする
# ==============================================================================
FROM ros:${ROS_DISTRO} AS runtime-base

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
  curl gnupg2 lsb-release python3-pip wget build-essential ca-certificates git ccache \
  python3-argcomplete python3-colcon-common-extensions python3-rosdep \
  ros-${ROS_DISTRO}-ros2bag ros-${ROS_DISTRO}-ros2bag-* \
  ros-${ROS_DISTRO}-rosbag2-storage-mcap \
  ros-${ROS_DISTRO}-imu-tools \
  ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
  ros-${ROS_DISTRO}-librealsense2* \
  ros-${ROS_DISTRO}-realsense2-* \
  ros-${ROS_DISTRO}-spatio-temporal-voxel-layer \
  ros-${ROS_DISTRO}-gtsam \
  libnanoflann-dev \
  libgeographic-dev \
  nlohmann-json3-dev \
  libyaml-cpp-dev \
  ros-${ROS_DISTRO}-ublox-msgs

RUN --mount=type=cache,id=mg-pip,target=/root/.cache/pip \
  pip3 install -U transforms3d "pytest>=7.0.0"

# --- pre-copy: 依存解決ファイルのみ先にコピー（キャッシュ最適化）---
# make build 実行時に docker/collect_deps.sh が docker/deps/ を準備する。
# ここでは事前に用意された内容のみをコピーし、後段で全ソースを反映する。
COPY docker/deps/ /app/

WORKDIR /root/ros2_ws/src
RUN ln -s /app ./mg

WORKDIR /root/ros2_ws
RUN python3 /app/docker/vcs_import.py -s src/mg -r -o src || true
RUN python3 /app/docker/pip_requirements.py -s src/mg -r || true
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && rosdep update --rosdistro ${ROS_DISTRO} \
  && rosdep install -yir --from-paths src --rosdistro ${ROS_DISTRO} --skip-keys pytest

# ==============================================================================
# Stage: runtime
# ==============================================================================
FROM runtime-base AS runtime

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

# --- full copy: 全ソースをコピーしてビルド ---
COPY . /app
RUN rm -rf /app/docker/deps/

ENV CCACHE_DIR=/root/.ccache
RUN --mount=type=cache,id=mg-ccache,target=/root/.ccache \
  . /opt/ros/${ROS_DISTRO}/setup.sh && \
  colcon build --symlink-install \
    --cmake-args \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -DCMAKE_BUILD_TYPE=Release

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc \
  && echo "source /root/ros2_ws/install/setup.bash" >> ~/.bashrc

# ==============================================================================
# Stage: develop-pkgs
# develop 系で使うaptパッケージのキャッシュ層（runtime変更の影響を受けない）
# ==============================================================================
FROM runtime-base AS develop-pkgs

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
  && chmod a+r /etc/apt/keyrings/docker.asc \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
  vim \
  docker-ce-cli \
  docker-compose-plugin \
  qtbase5-dev libqt5svg5-dev libzmq3-dev libdw-dev \
  ros-${ROS_DISTRO}-rviz2 \
  ros-${ROS_DISTRO}-foxglove-bridge \
  ros-${ROS_DISTRO}-teleop-twist-keyboard \
  ros-${ROS_DISTRO}-rqt ros-${ROS_DISTRO}-rqt-*

# ==============================================================================
# Stage: develop
# ==============================================================================
FROM develop-pkgs AS develop

ARG ROS_DISTRO

COPY --from=runtime /app /app
COPY --from=runtime /root/ros2_ws/src /root/ros2_ws/src
COPY --from=runtime /root/ros2_ws/build /root/ros2_ws/build
COPY --from=runtime /root/ros2_ws/install /root/ros2_ws/install

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc \
  && echo "source /root/ros2_ws/install/setup.bash" >> ~/.bashrc

# ==============================================================================
# Stage: simulation-pkgs
# simulation 系で使うaptパッケージのキャッシュ層（runtime変更の影響を受けない）
# ==============================================================================
FROM develop-pkgs AS simulation-pkgs

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
  ros-${ROS_DISTRO}-ros-gz-sim \
  ros-${ROS_DISTRO}-ros-gz-bridge \
  ros-${ROS_DISTRO}-ros-gz-image \
  ros-${ROS_DISTRO}-ros-gz-interfaces

# RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
#   --mount=type=cache,target=/var/lib/apt,sharing=locked \
#   apt-get update \
#   && apt-get install -y software-properties-common \
#   && add-apt-repository ppa:kisak/kisak-mesa \
#   && apt-get upgrade -y \
#   && apt-get autoremove --purge -y

# ==============================================================================
# Stage: simulation
# ==============================================================================
FROM simulation-pkgs AS simulation

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO

COPY --from=develop /app /app
COPY --from=develop /root/ros2_ws/src /root/ros2_ws/src
COPY --from=develop /root/ros2_ws/build /root/ros2_ws/build
COPY --from=develop /root/ros2_ws/install /root/ros2_ws/install

WORKDIR /root/ros2_ws
RUN python3 /app/docker/vcs_import.py -s src/mg/mg_simulator_client -r -o src || true

ENV CCACHE_DIR=/root/.ccache
RUN --mount=type=cache,id=mg-ccache,target=/root/.ccache \
  . /opt/ros/${ROS_DISTRO}/setup.sh && \
  colcon build --symlink-install \
    --packages-select mg_simulation sim_scenario_test mg_scenario_test mg_simulator_client ros_tcp_endpoint \
    --cmake-args \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -DCMAKE_BUILD_TYPE=Release

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc \
  && echo "source /root/ros2_ws/install/setup.bash" >> ~/.bashrc

# ==============================================================================
# Stage: frontend-builder
# React フロントエンドをビルドする。ランタイムに Node.js は不要。
# ==============================================================================
FROM node:20-slim AS frontend-builder

WORKDIR /frontend
COPY mg_ui/mg_web_ui/frontend/package*.json ./
RUN npm install
COPY mg_ui/mg_web_ui/frontend/ ./
RUN npm run build

# ==============================================================================
# Stage: web-ui
# foxglove_bridge + HTTP静的配信。runtime をベースに dist/ を焼き込む。
# ==============================================================================
FROM runtime AS web-ui

ARG ROS_DISTRO
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
  ros-${ROS_DISTRO}-foxglove-bridge

COPY --from=frontend-builder /frontend/dist/ /root/ros2_ws/install/mg_web_ui/share/mg_web_ui/frontend/dist/

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc \
  && echo "source /root/ros2_ws/install/setup.bash" >> ~/.bashrc